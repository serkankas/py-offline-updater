[Unit]
Description=Chromium Kiosk Mode Browser
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=root
Environment="XDG_RUNTIME_DIR=/run/user/0"
Environment="WAYLAND_DISPLAY=wayland-1"

# Timeout'u artır - Docker geç başlıyor
TimeoutStartSec=180

# Docker hazır mı? Max 120s bekle
ExecStartPre=/bin/bash -c 'for i in {1..120}; do docker ps >/dev/null 2>&1 && break; sleep 1; done'

# Frontend container healthy mı? Max 60s bekle
ExecStartPre=/bin/bash -c 'for i in {1..60}; do docker inspect frontend --format="{{.State.Health.Status}}" 2>/dev/null | grep -q "healthy" && break; sleep 1; done'

ExecStart=/usr/bin/chromium \
  --no-sandbox \
  --disable-gpu \
  --single-process \
  --kiosk \
  --incognito \
  --ozone-platform=wayland \
  http://localhost

Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target