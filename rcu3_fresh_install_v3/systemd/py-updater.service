[Unit]
Description=py-offline-updater Web Service
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/app/app/update
Environment="PYTHONPATH=/app/app/update/update-engines/current"
ExecStart=/usr/bin/python3 -m uvicorn update_service.main:app --host 0.0.0.0 --port 8123
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
